<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>.HARI</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #01070d;
}

body {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, sans-serif;
    color: #7ddcff;
}

/* MAIN HARI SCREEN */

.hari {
    width: 100vw;
    height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle at center,
        rgba(0,130,255,0.13) 0%,
        rgba(0,30,60,0.08) 30%,
        #01070d 70%);
}

/* CENTRAL ORB */

.orb {
    width: min(82vw, 600px);
    height: min(82vw, 600px);
    border-radius: 50%;
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    background:
        radial-gradient(circle,
        rgba(0,80,140,0.25),
        rgba(0,10,20,0.55) 58%,
        transparent 70%);

    box-shadow:
        0 0 30px rgba(0,170,255,.25),
        0 0 90px rgba(0,120,255,.12);

    transition: .4s ease;
}

/* OUTER RINGS */

.orb::before {
    content: "";
    position: absolute;
    inset: 2%;
    border-radius: 50%;

    border:
        2px solid rgba(0,180,255,.7);

    box-shadow:
        0 0 15px rgba(0,190,255,.8),
        inset 0 0 20px rgba(0,190,255,.35);

    animation: rotate 18s linear infinite;
}

/* SECOND RING */

.orb::after {
    content: "";
    position: absolute;
    inset: 9%;
    border-radius: 50%;

    border:
        1px dashed rgba(0,200,255,.75);

    box-shadow:
        0 0 15px rgba(0,190,255,.4);

    animation: rotateReverse 10s linear infinite;
}

/* HARI CORE */

.core {
    width: 54%;
    height: 54%;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(circle,
        rgba(0,50,85,.75),
        rgba(0,10,20,.9) 70%);

    border: 1px solid rgba(0,190,255,.8);

    box-shadow:
        0 0 25px rgba(0,180,255,.45),
        inset 0 0 35px rgba(0,160,255,.18);

    animation: breathe 3s ease-in-out infinite;
}

.logo {
    font-size: clamp(28px, 8vw, 58px);
    letter-spacing: 9px;
    color: #d9f8ff;

    text-shadow:
        0 0 8px #00bfff,
        0 0 25px #008cff,
        0 0 50px rgba(0,160,255,.7);

    user-select: none;
}

/* STATUS */

.status {
    position: absolute;
    bottom: 8%;
    left: 50%;
    transform: translateX(-50%);

    font-size: 12px;
    letter-spacing: 4px;

    color: rgba(160,230,255,.7);

    text-shadow: 0 0 12px #00aaff;

    user-select: none;
}

/* MICROPHONE */

.mic {
    position: absolute;

    bottom: 13%;
    left: 50%;

    transform: translateX(-50%);

    width: 52px;
    height: 52px;

    border-radius: 50%;

    border: 1px solid rgba(0,190,255,.7);

    background: rgba(0,20,35,.8);

    color: #8eeaff;

    font-size: 20px;

    box-shadow:
        0 0 20px rgba(0,180,255,.25);

    cursor: pointer;
}

/* STATES */

.listening .orb {
    transform: scale(1.025);
    box-shadow:
        0 0 50px rgba(0,200,255,.5),
        0 0 120px rgba(0,150,255,.25);
}

.listening .core {
    animation: breathe .6s ease-in-out infinite;
}

.thinking .orb::before {
    animation: rotate 2s linear infinite;
}

.speaking .core {
    animation: breathe .45s ease-in-out infinite;
}

/* ANIMATIONS */

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

@keyframes rotateReverse {
    from {
        transform: rotate(360deg);
    }

    to {
        transform: rotate(0deg);
    }
}

@keyframes breathe {
    0%, 100% {
        transform: scale(.96);
    }

    50% {
        transform: scale(1.04);
    }
}
</style>
</head>

<body>

<div class="hari" id="hari">

    <div class="orb" id="orb">

        <div class="core">
            <div class="logo">.HARI.</div>
        </div>

    </div>

    <div class="status" id="status">
        READY
    </div>

    <button class="mic" id="mic">
        🎙
    </button>

</div>

<script>

const hari = document.getElementById("hari");
const statusText = document.getElementById("status");
const orb = document.getElementById("orb");
const mic = document.getElementById("mic");

function setState(state) {

    hari.className = "hari";

    if (state === "LISTENING") {
        hari.classList.add("listening");
    }

    if (state === "THINKING") {
        hari.classList.add("thinking");
    }

    if (state === "SPEAKING") {
        hari.classList.add("speaking");
    }

    statusText.textContent = state;
}


/* VOICE INPUT */

let recognition = null;

if (
    "SpeechRecognition" in window ||
    "webkitSpeechRecognition" in window
) {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    recognition = new SpeechRecognition();

    recognition.lang = "en-IN";

    recognition.continuous = false;

    recognition.interimResults = false;


    recognition.onstart = function () {

        setState("LISTENING");

    };


    recognition.onresult = function(event) {

        const text =
            event.results[0][0].transcript;

        console.log("You:", text);

        processCommand(text);

    };


    recognition.onerror = function() {

        setState("READY");

    };


    recognition.onend = function() {

        if (hari.classList.contains("listening")) {
            setState("READY");
        }

    };

}


/* TEMPORARY BRAIN */

function processCommand(text) {

    setState("THINKING");

    setTimeout(function() {

        const lower = text.toLowerCase();

        let response;

        if (lower.includes("hello") ||
            lower.includes("hi") ||
            lower.includes("hey")) {

            response =
                "Hey bro. .HARI is online.";

        } else {

            response =
                "I heard you. My brain connection is coming next.";

        }

        speak(response);

    }, 900);

}


/* VOICE OUTPUT */

function speak(text) {

    if (!("speechSynthesis" in window)) {

        setState("READY");

        return;

    }

    speechSynthesis.cancel();

    const voice =
        new SpeechSynthesisUtterance(text);

    voice.lang = "en-IN";

    voice.rate = 1.0;

    voice.pitch = 1.0;


    voice.onstart = function() {

        setState("SPEAKING");

    };


    voice.onend = function() {

        setState("READY");

    };


    speechSynthesis.speak(voice);

}


/* START LISTENING */

function listen() {

    if (!recognition) {

        speak(
            "Voice recognition isn't available in this browser."
        );

        return;

    }

    try {

        recognition.start();

    } catch (error) {

        console.log(error);

    }

}


orb.addEventListener("click", listen);

mic.addEventListener("click", listen);


setState("READY");

</script>

</body>
</html>
